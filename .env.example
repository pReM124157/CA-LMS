NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_runner
LMS_BASE_URL=http://localhost:4000
LMS_LOGIN_URL=http://localhost:4000/login
# Leave empty for local Chromium. Set only in production for a Browserbase/Browserless CDP endpoint.
REMOTE_BROWSER_WS_URL=
RUNNER_DATA_DIR=./data
MUTE_VIDEO=true
PLAYBACK_RATE_POLICY=max_allowed
PLAYBACK_RATE=2
CUSTOM_PLAYER_SELECTOR=
CUSTOM_NEXT_BUTTON_SELECTOR=
CUSTOM_QUESTION_SELECTOR=
CUSTOM_OPTION_SELECTOR=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
QWEN_API_KEY=
QWEN_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=3
AI_HIGH_CONFIDENCE=0.85
AI_MEDIUM_CONFIDENCE=0.65
ALLOW_SEARCH_ASSIST=false
REQUIRE_HUMAN_CONFIRMATION=true
AUTO_SUBMIT=false
AUTOSUBMIT_ALLOWED_HOSTS=localhost,127.0.0.1
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PLAYER_POLL_INTERVAL_MS=2000
QUESTION_POLL_INTERVAL_MS=1500
VIDEO_STALL_THRESHOLD_SECONDS=30
WATCHDOG_INTERVAL_SECONDS=30
LOG_LEVEL=info
DEBUG_SCREENSHOTS=true
DEBUG_SCREENSHOT_RETENTION_DAYS=7
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
